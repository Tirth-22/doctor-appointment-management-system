# Database Configuration
# PostgreSQL Configuration
POSTGRES_DB=doctor_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Tirth_22
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Spring Boot Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/doctor_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=Tirth_22
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# JPA/Hibernate Configuration
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect
SPRING_JPA_SHOW_SQL=false

# JWT Configuration
JWT_SECRET_KEY=your_super_secret_jwt_key_change_this_in_production_with_minimum_256_bits_length_for_security_purposes
JWT_EXPIRATION_TIME=86400000

# Server Configuration
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/

# Logging
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_DOCTORAPP=DEBUG

# Jackson Configuration
SPRING_JACKSON_SERIALIZATION_WRITE_DATES_AS_TIMESTAMPS=false
SPRING_JACKSON_DEFAULT_PROPERTY_INCLUSION=non_null

# Management/Actuator
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=when-authorized
